PROJECT_NAME="ENI Mail API"
ENVIRONMENT=development
API_V1_STR=/api

# ──────────────────────────────────────────────
# PostgreSQL (psycopg3 dialect)
# ──────────────────────────────────────────────
POSTGRES_DB=eni_mailing
POSTGRES_USER=eni_user
POSTGRES_PASSWORD=change_this_password
# Sans Docker : PostgreSQL installé sur la machine (localhost).
# Avec Docker Compose, l'URL (hôte « db ») est définie dans docker-compose.yml.
DATABASE_URL=postgresql+psycopg://eni_user:change_this_password@localhost:5432/eni_mailing

# ──────────────────────────────────────────────
# Sécurité JWT
# ──────────────────────────────────────────────
SECRET_KEY=dev_secret_key_change_in_production_super_secure_hash_12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ──────────────────────────────────────────────
# CORS — origines autorisées (frontend Angular / React)
# ──────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:4200","http://127.0.0.1:4200","http://localhost:3000","http://localhost:5173"]

# ──────────────────────────────────────────────
# SMTP — Envoi d'emails (OTP, notifications)
# Si non configuré, le backend simule l'envoi en développement
# ──────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@eni.mg
SMTP_FROM_NAME="ENI Mailing"
SMTP_TLS=True
